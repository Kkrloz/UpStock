# ---------------------------------------------------------------------------
# Arquivo de referência. O Spring Boot NÃO lê .env automaticamente:
# as variáveis precisam existir no ambiente (Render, IDE, ou `docker compose`).
# ---------------------------------------------------------------------------

# Backend (Spring Boot)
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
JWT_SECRET=generate-via-openssl-rand-base64-32
JWT_EXPIRATION=86400000
ADMIN_PASSWORD=change-me
SHOW_SQL=false
DB_POOL_SIZE=5
CORS_ALLOWED_ORIGINS=https://up-stock-kappa.vercel.app,http://localhost:5173,http://localhost:8080

# Frontend (Vite) — usado na Vercel, não no Render
VITE_API_URL=http://localhost:8080
